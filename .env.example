# Copy this file to .env and fill in your values

# --- OpenRouter LLM API (required) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_HOST=https://openrouter.ai/api/v1

# --- Model Selection (defaults shown, override as needed) ---
# PRIMARY_MODEL=google/gemini-3-flash-preview      # Scorecard generation (single_llm, rag_llm)
# EXTRACTION_MODEL=openai/gpt-4.1-mini             # Structured JSON extraction (multi_agentic)
# JUDGE_MODEL=openai/gpt-4.1-mini                  # deepeval GEval judge
# Alternatives: google/gemini-2.5-flash-preview (cheaper), openai/gpt-5-mini (reasoning), openai/gpt-4.1-nano (cheapest)

# --- NCBI / PubMed (recommended) ---
ENTREZ_EMAIL=your_email@example.com
# NCBI_API_KEY=your_ncbi_api_key_here

# --- RAG / Vector DB (defaults are fine for local dev) ---
# LANCEDB_URI=./lancedb
# VECTOR_DB_TABLE_NAME=pubmed_embeddings
# EMBEDDING_MODEL_FOR_RAG=all-mpnet-base-v2       # Upgraded from all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=768                          # 768 for mpnet, was 384 for MiniLM
# RAG_NUM_RESULTS=5

# --- Exclusions (optional, to avoid data leakage) ---
# EXCLUDE_NCT_ID=
# EXCLUDE_PMID=
