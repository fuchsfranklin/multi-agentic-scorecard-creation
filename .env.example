# Copy this file to .env and fill in your values

# --- OpenRouter LLM API (required) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_HOST=https://openrouter.ai/api/v1

# --- Model Selection (defaults shown, override as needed) ---
# PRIMARY_MODEL=google/gemini-3-flash-preview      # Scorecard generation (single_llm, rag_llm). $0.50/$3.00 per M tokens.
# EXTRACTION_MODEL=openai/gpt-5.1-mini             # Structured JSON extraction (multi_agentic). $0.25/$2.00 per M tokens.
# JUDGE_MODEL=openai/gpt-5.1-mini                  # deepeval GEval judge. $0.25/$2.00 per M tokens.
#
# Alternatives:
#   openai/gpt-4.1-mini    — legacy, still in API but retired from ChatGPT. $0.40/$1.60. Non-reasoning, fast.
#   google/gemini-2.5-flash — stable GA. $0.30/$2.50. Previous-gen but reliable.
#   openai/gpt-5-mini      — reasoning model. $0.25/$2.00. Predecessor to 5.1-mini.
#   google/gemini-2.5-flash-lite — cheapest. $0.10/$0.40. Lower intelligence.

# --- NCBI / PubMed (recommended) ---
ENTREZ_EMAIL=your_email@example.com
# NCBI_API_KEY=your_ncbi_api_key_here

# --- RAG / Vector DB (defaults are fine for local dev) ---
# LANCEDB_URI=./lancedb
# VECTOR_DB_TABLE_NAME=pubmed_embeddings
# EMBEDDING_MODEL_FOR_RAG=all-mpnet-base-v2       # 768d, good for biomedical text
# EMBEDDING_DIMENSION=768
# RAG_NUM_RESULTS=5

# --- Exclusions (optional, to avoid data leakage) ---
# EXCLUDE_NCT_ID=
# EXCLUDE_PMID=
